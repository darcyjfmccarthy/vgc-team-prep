{
  "name": "vgc-team-prep",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bootstrap": "node scripts/bootstrap.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:migrations": "tsx scripts/db.ts test-migrations",
    "test:e2e": "playwright test",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:rollback": "tsx scripts/db.ts rollback",
    "db:status": "tsx scripts/db.ts status",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db.ts reset",
    "worker:dev": "tsx watch src/jobs/worker.ts",
    "worker:once": "tsx src/jobs/worker.ts --once",
    "jobs:list": "tsx scripts/jobs.ts list",
    "jobs:retry": "tsx scripts/jobs.ts retry"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "dotenv": "17.2.2",
    "kysely": "0.28.8",
    "next": "16.3.3",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "13.0.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.3",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
